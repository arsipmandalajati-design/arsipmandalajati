{
    "version": 2,
    "framework": "laravel",
    "functions": {
      "api/index.php": {
        "maxDuration": 60
      }
    },
    "routes": [
      {
        "src": "/css/(.*)",
        "dest": "/public/css/$1"
      },
      {
        "src": "/js/(.*)",
        "dest": "/public/js/$1"
      },
      {
        "src": "/images/(.*)",
        "dest": "/public/images/$1"
      },
      {
        "src": "/favicon.ico",
        "dest": "/public/favicon.ico"
      },
      {
        "src": "/(.*)",
        "dest": "/api/index.php"
      }
    ]
  }